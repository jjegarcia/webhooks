<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="matchSummaryInfo"
            type="com.application.hooksPlus.support.IntentArguments.MatchSummaryInfo" />
    </data>

    <LinearLayout
        android:id="@+id/place_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">


        <ImageView
            android:id="@+id/placeView"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="0dp"
            android:contentDescription="@string/place"
            android:src="@drawable/ic_format_list_numbered_24px" />

        <TextView
            android:id="@+id/placeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="0dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:text="@{matchSummaryInfo.placeText}"
            tools:text="ooo" />
    </LinearLayout>
</layout>
